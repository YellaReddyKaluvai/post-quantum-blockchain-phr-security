# ─────────────────────────────────────────────────────────────────────────────
# QuantumCare — environment configuration
#
#   cp .env.example .env      then fill in the values below
#
# Never commit .env. The real one holds live credentials and is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Where PostgreSQL is. This is the value the application reads.
# Port 5433 is used here because macOS installers often already occupy 5432 —
# change it to 5432 if yours is on the default.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/pqc_hospital

# The maintenance scripts in backend/ (generate_dataset.py and the repair
# scripts) read these separately rather than parsing the URL above. Keep them
# consistent with it.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=pqc_hospital
DB_USER=postgres
DB_PASSWORD=

# Signs session tokens. At least 32 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank (or as a placeholder) a random key is generated into
# backend/.secret_key on first start — set it explicitly when running more than
# one server, so they all accept the same sessions.
SECRET_KEY=

# Keys the pseudonymous references written to the consent contract. Generated
# into backend/.ledger_key when blank. Never change it once consents are
# on-chain: every existing on-chain consent would stop matching.
CONSENT_LEDGER_KEY=

# Encrypts personal and clinical columns. MUST be exactly 32 characters —
# shorter is padded and longer is truncated, so a mistake here silently
# weakens the key rather than failing.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
#
# Anything encrypted with one key cannot be read with another. Changing this
# on a database that already holds data makes that data permanently unreadable.
# Blank falls back to a public example key, kept only so existing development
# databases stay readable; the server warns about it at every start. To move an
# existing database to a new key, stop the server and run
#   python rotate_encryption_key.py                       (check only)
#   NEW_ENCRYPTION_KEY=<new> python rotate_encryption_key.py --apply
# then set the new key here.
ENCRYPTION_KEY=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7


# ── OPTIONAL — every one of these can be left blank ──────────────────────────
#
# The system is built to run without them and to say so honestly rather than
# pretend. No S3 means the database copy is the only copy; no chain means
# anchors are labelled "local-simulated"; no IPFS means a content address is
# computed but nothing is published.

# Email for registration approvals. Blank = approvals still work, no mail sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS before login. Keep true for any real mail server; false only for a
# local test server without TLS (CI uses Mailpit).
SMTP_STARTTLS=true
ADMIN_EMAIL=

# Used only by seed_admin.py when creating the first administrator account.
# Blank (or under 12 characters) generates a random password, printed once.
ADMIN_PASSWORD=

# Cloud storage. Blank = reports live only in the database.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-north-1
# An S3-compatible store (MinIO, Ceph, …) instead of AWS. Blank = AWS.
AWS_S3_ENDPOINT_URL=

# Blockchain anchoring against a local anvil chain.
# The contract address below is deterministic for anvil's first deployment,
# so it needs no editing when you deploy with the standard test account.
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=anvil-local
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_EXPLORER_URL=

# IPFS publishing. Blank = a CID is computed but nothing is pinned.
IPFS_API_URL=http://127.0.0.1:5001

# IPFS replication (optional). Each published CID is copied to every target in
# the background; only copies a target confirms count. Blank = this node only.
# Other kubo nodes, comma-separated API URLs:
IPFS_REPLICA_NODES=
# Pinning services implementing the IPFS Pinning Service API, as a JSON list:
#   [{"name":"pinata","endpoint":"https://api.pinata.cloud/psa","token":"<JWT>"}]
IPFS_PINNING_SERVICES=
# Seconds to wait for a replica node to confirm a pin (default 60).
IPFS_REPLICATION_TIMEOUT=60

# ─── AI risk policy (spec §23) ─────────────────────────────────────────────────
# What a risk score does at the moment a record is opened. Applied after RBAC
# and consent, never instead of them; a low score cannot open a closed record.
#   monitor = allow + alert   verify = re-enter password   block = refuse + incident
RISK_POLICY_MEDIUM=monitor
RISK_POLICY_HIGH=verify
RISK_POLICY_EMERGENCY_HIGH=monitor
STEP_UP_MINUTES=10
RISK_WINDOW_HOURS=24
RISK_MIN_PEERS=3
# Scheduled anomaly analysis; 0 disables (the inline risk gate still runs).
SECURITY_ANALYSIS_INTERVAL_MINUTES=30
# Break-glass declarations allowed per doctor per 24 hours.
EMERGENCY_MAX_PER_DAY=3

# ─── Federated learning as a participant (spec §20–21) ─────────────────────────
# Set all three to submit this hospital's per-role model to another hospital's
# hub and pull the global model back. The secret is issued when the hub's
# administrator registers this hospital under Admin → Federation Peers.
FEDERATION_HUB_URL=
FEDERATION_NODE_NAME=
FEDERATION_SHARED_SECRET=
